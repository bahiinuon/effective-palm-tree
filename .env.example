# Copy to .env (in the repo root or server/) before running the server.

# Port the API and the built site are served on.
PORT=3001

# Where the SQLite file lives. Back this up - it is the whole order book.
DATABASE_FILE=data/requests.db

# Long random string. The artist dashboard at /#/admin is disabled until this
# is set, and the admin API returns 503. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# How a fan pays: "manual" or "stripe".
#   manual - the request is recorded unpaid and you invoice however you like.
#   stripe - Stripe Checkout, hosted by Stripe; no card details touch this app.
PAYMENT_PROVIDER=manual

# --- Stripe (only needed when PAYMENT_PROVIDER=stripe) ---------------------
# Dashboard > Developers > API keys. Use the test key (sk_test_...) until you
# have run a real card through it.
STRIPE_SECRET_KEY=

# Dashboard > Developers > Webhooks. Add an endpoint pointing at
#   https://your-domain/api/webhooks/stripe
# subscribed to checkout.session.completed and checkout.session.expired, then
# copy its signing secret (whsec_...) here. Without it
# webhooks are rejected, and requests stay stuck at "pending".
STRIPE_WEBHOOK_SECRET=

# When the fan pays:
#   accept - brief arrives free; you send a payment link from the queue (default)
#   submit - card taken as they send the brief
STRIPE_CHARGE_AT=accept

# Public origin of the site, used to build the URLs Stripe returns fans to.
PUBLIC_URL=http://localhost:3001

# Requests accepted per IP per 10 minutes.
REQUEST_RATE_LIMIT=5

# Number of proxy hops in front of the app, for correct client IPs.
TRUST_PROXY_HOPS=1
